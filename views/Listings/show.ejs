<% layout('layouts/boilerplate.ejs') %>
<br />
<h3 class="text-center">
    <%= listing.title %>
</h3>
<div class="row">
    <div class="col-8 offset-2">
        <div class="card listing-card">
            <div class="text-center">
                <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=600' %>" 
                     class="card-img-top show-img"
                     alt="<%= listing.title %>" />
            </div>
            <div class="card-body">
                <p class="card-text">
                    <strong>Owned by:</strong>
                    <i><%= listing?.owner?.username || 'Not specified' %></i>
                </p>
                <p class="card-text">
                    <%= listing.description %>
                </p>
                <div class="card-text">
                    <ul class="list-unstyled">
                        <li class="mb-1">
                            <b>Category:</b>
                            <span class="category-badge ms-1"><%= listing?.category || 'Trending' %></span>
                        </li>
                        <li class="mb-1">
                            <b>Price:</b> &#8377;
                            <%= listing?.price?.toLocaleString("en-IN") || 'Not specified' %> / night
                            <% const showTax = listing.tax || 18; %>
                            <span class="text-muted ms-1">(with <%= showTax %>% GST: &#8377; <%= Math.round((listing?.price || 0) * (1 + showTax / 100)).toLocaleString("en-IN") %>)</span>
                        </li>
                        <li class="mb-1">
                            <b>Location:</b>
                            <%= listing?.location || 'Not specified' %>
                        </li>
                        <li class="mb-1">
                            <b>Country:</b>
                            <%= listing?.country || 'Not specified' %>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-8 offset-2 mb-4 d-flex flex-wrap align-items-center gap-2">
        <% if (listing?.owner?._id?.toString() === currentUser?._id?.toString()) { %>
            <a href="/Listings/<%= listing._id %>/edit" class="btn btn-theme d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-pen-to-square"></i> Edit Listing
            </a>
        <% } %>
        <a href="/Listings" class="btn btn-secondary d-inline-flex align-items-center gap-1">
            <i class="fa-solid fa-arrow-left"></i> Go to all Listings
        </a>
        <% if (listing?.owner?._id?.toString() === currentUser?._id?.toString()) { %>
            <form method="POST" action="/Listings/<%= listing._id %>?_method=DELETE" class="d-inline m-0">
                <button class="btn btn-danger d-inline-flex align-items-center gap-1" onclick="return confirm('Are you sure you want to delete this listing?');">
                    <i class="fa-solid fa-trash"></i> Delete Listing
                </button>
            </form>
        <% } %>
    </div>

    <div class="col-8 offset-2 mb-4">
        <% if(currentUser) { %>                
            <hr />
            <h4>Leave a Review</h4>
            <form novalidate class="needs-validation" method="POST" action="/Listings/<%= listing._id %>/reviews">
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating:</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="rate-5" name="review[rating]" value="5" />
                        <label for="rate-5" title="5 stars"></label>
                        <input type="radio" id="rate-4" name="review[rating]" value="4" />
                        <label for="rate-4" title="4 stars"></label>
                        <input type="radio" id="rate-3" name="review[rating]" value="3" />
                        <label for="rate-3" title="3 stars"></label>
                        <input type="radio" id="rate-2" name="review[rating]" value="2" />
                        <label for="rate-2" title="2 stars"></label>
                        <input type="radio" id="rate-1" name="review[rating]" value="1" />
                        <label for="rate-1" title="1 star"></label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment:</label>
                    <textarea class="form-control" id="comment" name="review[comment]" rows="3" placeholder="Share your experience..." required></textarea>
                    <div class="invalid-feedback">Please enter your comment.</div>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Submit Review</button>
            </form>
        <% } else { %>
            <hr />
            <p class="text-center text-muted">Please <a href="/login">log in</a> to leave a review.</p>
        <% } %>

        <hr />
        <h4>Reviews</h4>
        <% if (!listing?.reviews?.length) { %>
            <p class="text-muted">No reviews yet. Be the first to review this place!</p>
        <% } else { %>
            <div class="row row-cols-md-2 g-3 mb-3">
                <% listing.reviews.forEach(review => { %>
                    <div class="col">
                        <div class="card h-100 p-3 shadow-sm border">
                            <div class="card-body p-0">
                                <h6 class="card-title mb-1">
                                    <i class="fas fa-user-circle me-1 text-secondary"></i>
                                    <%= review.author?.username || 'Anonymous' %>
                                </h6>
                                <p class="starability-result text-warning mb-2" data-rating="<%= review.rating %>">
                                    <% for(let s = 1; s <= 5; s++) { %>
                                        <i class="fa<%= s <= review.rating ? 's' : 'r' %> fa-star text-warning"></i>
                                    <% } %>
                                </p>
                                <p class="card-text text-muted mb-2"><%= review.comment %></p>
                                <% if (review.author?._id?.toString() === currentUser?._id?.toString()) { %>
                                    <form method="POST" action="/Listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <div class="col-8 offset-2 mb-5">
        <hr />
        <h4>Where you'll be</h4>
        <p class="text-muted mb-2"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %></p>
        <div id="map" class="show-map" data-token="<%= mapToken || '' %>" data-listing='<%- JSON.stringify(listing) %>'></div>
    </div>
</div>

<script src="/js/map.js"></script>
