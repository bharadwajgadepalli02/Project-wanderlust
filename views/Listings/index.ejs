<% layout('layouts/boilerplate.ejs') -%>
<div class="row">
    <% for (let listing of allListings) { %>
        <div class="col-md-4">
            <a href="/Listings/<%= listing._id %>">
                <div class="card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" />
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= listing.title %>
                        </h5>
                        <p class="card-text">
                            <%= listing.description %>
                        </p>
                        <a href="#" class="btn btn-sm btn-dark mt-1 view-btn">see more</a>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>